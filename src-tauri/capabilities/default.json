{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "splashscreen"
  ],
  "remote": {
    "urls": [
      "https://*.metabuilderpro.com",
      "https://*.metabuilderpro.com/*",
      "https://metabuilderpro.com",
      "https://metabuilderpro.com/*",
      "https://metabuilderpro.com/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:app:default",
    "core:app:allow-version",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "npm",
          "cmd": "npm",
          "args": [
            "install"
          ]
        },
        {
          "name": "npm-run-dev",
          "cmd": "npm",
          "args": [
            "run",
            "dev"
          ]
        },
        {
          "name": "code",
          "cmd": "code",
          "args": [
            "."
          ]
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": [
            "/c",
            "npm",
            "install"
          ]
        },
        {
          "name": "cmd-npm-run-dev",
          "cmd": "cmd",
          "args": [
            "/c",
            "npm",
            "run",
            "dev"
          ]
        }
      ]
    }
  ]
}
